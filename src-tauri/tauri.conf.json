{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Guohe Hosts",
  "version": "1.2.0",
  "identifier": "com.guohe.hosts",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Guohe Hosts v1.2.0",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
